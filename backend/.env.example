# Prometheus is contacted server-to-server. Do not put this token in Vite or Android.
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_BEARER_TOKEN=
# Instant-vector query. Required labels: node_id, sensor_type; optional: zone_id, unit, sensor_id.
PROMETHEUS_TELEMETRY_QUERY=mine_sensor_reading
PROMETHEUS_TIMEOUT_SECONDS=10

# Run Gemma locally at the mine edge for alert transitions and periodic summaries,
# rather than for every individual sensor packet.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_MIN_INTERVAL_SECONDS=300
OLLAMA_ENABLED=true

# Comma-separated browser origins. Android is not subject to CORS.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
